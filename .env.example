#===============================================================================
# AI Cluster Configuration - Example
#===============================================================================
# Copy this file to .env and customize for your environment
# Most values can be left as defaults for initial setup
#
# SECURITY: Generate new secrets before deployment!
# Use: cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 64 | head -n 1
# Or let setup.sh auto-generate them for you
#===============================================================================

#-------------------------------------------------------------------------------
# NETWORK CONFIGURATION
#-------------------------------------------------------------------------------
# CRITICAL: Set this to your LXC container IP (NOT Proxmox host IP!)
# The LXC 10.10.10.75 (internal-docker) should be used
#
COORDINATOR_IP=10.10.10.75
COORDINATOR_PORT=80

#-------------------------------------------------------------------------------
# SECURITY CONFIGURATION (IMPORTANT!)
#-------------------------------------------------------------------------------
# The system has multiple layers of security:
# 1. API Key authentication (all API requests except health check)
# 2. Subnet restriction (only 10.10.10.x can access)
# 3. Redis password (internal communication)
#
# For a home lab on a trusted network, this provides good security.
# For production/public networks, additional measures would be needed.
#-------------------------------------------------------------------------------

# API Key - REQUIRED for all API requests (except health check)
# Generate: cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 64 | head -n 1
# IMPORTANT: If not set, API endpoints will return 500 errors!
API_KEY=your-api-key-here

# Auth disabled flag - ONLY for testing/development
# Set to 'true' to run without API key (NOT RECOMMENDED)
# Leave unset or 'false' for production
AUTH_DISABLED=false

# Allowed subnet - Only IPs from this subnet can access the API
# Default: 10.10.10.0/24 (your local network)
# This provides defense-in-depth alongside API key auth
ALLOWED_SUBNET=10.10.10.0/24

# Redis password - Authentication for Redis connection
# Generate: cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 32 | head -n 1
REDIS_PASSWORD=your-redis-password-here

#-------------------------------------------------------------------------------
# COORDINATOR CONFIGURATION
#-------------------------------------------------------------------------------
API_VERSION=v1
FLASK_ENV=production

# Generate: cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 64 | head -n 1
SECRET_KEY=change-this-to-a-random-64-character-hex-string

# Redis (internal Docker network)
REDIS_URL=redis://redis:6379

# Database (SQLite inside container)
DATABASE_URL=sqlite:////data/jobs.db

# Storage Paths (Docker volume mounts)
MODELS_PATH=/models
RESULTS_PATH=/results
PROJECTS_PATH=/projects

#-------------------------------------------------------------------------------
# APPLICATION SETTINGS
#-------------------------------------------------------------------------------
# Default model for new jobs (must be downloaded first)
DEFAULT_MODEL=34b

# Days to keep completed job results (30, 60, or 90)
RESULT_RETENTION_DAYS=30

# Days to keep uploaded project files
PROJECT_RETENTION_DAYS=90

# Maximum jobs running simultaneously
MAX_CONCURRENT_JOBS=3

# Maximum project upload size in MB
MAX_PROJECT_SIZE_MB=100

# Enable real-time WebSocket progress updates
ENABLE_WEBSOCKET_PROGRESS=true

# Seconds before marking worker as offline (no heartbeat)
WORKER_HEARTBEAT_TIMEOUT=120

#-------------------------------------------------------------------------------
# MODEL DOWNLOAD
#-------------------------------------------------------------------------------
# Download 34B model automatically on first start
INITIAL_MODEL_DOWNLOAD=true

# HuggingFace token (optional, needed for gated models)
HUGGINGFACE_TOKEN=

#-------------------------------------------------------------------------------
# LOGGING
#-------------------------------------------------------------------------------
LOG_LEVEL=INFO
